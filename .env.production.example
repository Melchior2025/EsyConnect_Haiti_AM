DEBUG=False
SECRET_KEY=remplacez_par_une_cle_secrete_aleatoire_unique_de_50_caracteres_min
ALLOWED_HOSTS=esyconnect.ht,www.esyconnect.ht,.onrender.com,.railway.app
CSRF_TRUSTED_ORIGINS=https://esyconnect.ht,https://www.esyconnect.ht,https://votre-app.onrender.com
DATABASE_URL=postgres://user:password@host:5432/dbname
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@esyconnect.ht
EMAIL_HOST_PASSWORD=mot_de_passe_app
DEFAULT_FROM_EMAIL=EsyConnect Haïti <contact@esyconnect.ht>

