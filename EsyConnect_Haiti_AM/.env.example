# Configuration de la base de données
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://postgres:votre_mot_de_passe@localhost:5432/esyconnect_haiti

# Clé secrète Django (générer une nouvelle clé pour la production)
SECRET_KEY=votre_cle_secrete_longue_et_aleatoire

# Configuration de l'environnement
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com

# Paramètres de sécurité (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
