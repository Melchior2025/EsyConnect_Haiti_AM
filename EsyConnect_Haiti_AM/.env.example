# ==============================================================================
# EsyConnect Haïti - Modèle de Configuration (.env.example)
# Copiez ce fichier en '.env' pour le développement local
# ==============================================================================

# Mode Debug (True en développement local, False en production)
DEBUG=True

# Clé secrète Django (générez une clé aléatoire de 50+ caractères)
SECRET_KEY=django-insecure-cle-secrete-locale-dev-changez-moi-en-production

# Hôtes autorisés (séparés par des virgules, '*' en dev local)
ALLOWED_HOSTS=*

# Origines approuvées pour CSRF (séparées par des virgules)
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.io,http://localhost,http://127.0.0.1

# Base de données (PostgreSQL si DATABASE_URL est défini, sinon SQLite par défaut)
# DATABASE_URL=postgres://user:password@localhost:5432/esyconnect_haiti

# Sécurité HTTPS (automatiquement désactivée si DEBUG=True)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
WHITENOISE_MANIFEST_STRICT=False

# Configuration Email (Console en local: les emails s'affichent dans le terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EsyConnect Haïti <contact@esyconnect.ht>
