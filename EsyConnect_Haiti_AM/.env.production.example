# ==============================================================================
# EsyConnect Haïti - Modèle de Configuration Production (.env.production.example)
# À utiliser sur Render, Railway, DigitalOcean, VPS ou autre hébergeur
# ==============================================================================

# 1. ENVIRONNEMENT & SÉCURITÉ DE BASE
DEBUG=False
# Générez une clé secrète via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=remplacez_par_une_cle_secrete_aleatoire_unique_de_50_caracteres_min

# 2. DOMAINES AUTORISÉS (séparés par des virgules sans espaces)
ALLOWED_HOSTS=esyconnect.ht,www.esyconnect.ht,.onrender.com,.railway.app

# 3. ORIGINES CSRF APPROUVÉES (avec protocole https://)
CSRF_TRUSTED_ORIGINS=https://esyconnect.ht,https://www.esyconnect.ht,https://votre-app.onrender.com

# 4. BASE DE DONNÉES POSTGRESQL (fournie automatiquement par Render/Railway via DATABASE_URL)
DATABASE_URL=postgres://votre_utilisateur:votre_mot_de_passe@votre_hote_postgres:5432/nom_base_de_donnees

# 5. PARAMÈTRES DE SÉCURITÉ HTTPS (obligatoires en production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
WHITENOISE_MANIFEST_STRICT=False

# 6. CONFIGURATION EMAIL SMTP (pour réinitialisation de mot de passe et notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@esyconnect.ht
EMAIL_HOST_PASSWORD=mot_de_passe_application_google
DEFAULT_FROM_EMAIL=EsyConnect Haïti <contact@esyconnect.ht>

